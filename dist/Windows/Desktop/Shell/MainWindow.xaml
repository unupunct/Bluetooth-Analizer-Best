<Window x:Class="BluetoothFleetMonitor.Desktop.Shell.MainWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Fleet Monitor" Width="1360" Height="840" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Bluetooth" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Fleet Monitor" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers><DataTrigger Binding="{Binding Built}" Value="False"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}"/>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding StatusBar}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
