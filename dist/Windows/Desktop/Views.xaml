<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BluetoothFleetMonitor.Desktop.ViewModels"
                    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <!-- ============ Dashboard ============ -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource H1}" Text="Dashboard"/>

                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ScannerWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warn}" Text="Scanner needs attention"/>
                        <TextBlock Text="{Binding ScannerMessage}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <WrapPanel>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Registered devices"/><TextBlock Style="{StaticResource BigNumber}" Text="{Binding Registered}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Detected now"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Good}" Text="{Binding Detected}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}" ToolTip="Not heard recently while the scanner was able to hear. This is not proof of a disconnection."><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Missing from recent scans"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Warn}" Text="{Binding Missing}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}" ToolTip="The scanner was stopped, deaf or interrupted, so absence cannot be judged."><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Uncertain"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Muted}" Text="{Binding Uncertain}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Windows scanner"/><TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ScannerStateText}"/><TextBlock Style="{StaticResource MutedText}" Text="{Binding Rate}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Adapter"/><TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Adapter}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Last database update"/><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding LastUpdate}"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}" Opacity="0.6"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Unstable / needs investigation"/><TextBlock FontSize="14" Text="Arrives in Phase 4"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}" Opacity="0.6"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Mobile scanners / last sync"/><TextBlock FontSize="14" Text="Arrives in Phase 3"/></StackPanel></Border>
                    <Border Style="{StaticResource Tile}" Opacity="0.6"><StackPanel><TextBlock Style="{StaticResource MutedText}" Text="Active inspection sessions"/><TextBlock FontSize="14" Text="Arrives in Phase 3"/></StackPanel></Border>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Start scanning" Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="Stop scanning" Command="{Binding StopScanCommand}" IsEnabled="{Binding CanStop}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource H2}" Text="LIVE EVENT FEED (scanner and application events)"/>
                <DataGrid ItemsSource="{Binding Events}" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                        <DataGridTemplateColumn Header="Severity" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                        <DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="170"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Live Monitor ============ -->
    <DataTemplate DataType="{x:Type vm:LiveMonitorViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Live Monitor"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBox Width="190" Margin="0,0,8,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, manufacturer, room, id"/>
                <ComboBox Width="120" Margin="0,0,8,6" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/>
                <ComboBox Width="150" Margin="0,0,8,6" ItemsSource="{Binding SignalFilters}" SelectedItem="{Binding SignalFilter}"/>
                <TextBox Width="110" Margin="0,0,8,6" Text="{Binding RoomFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by room"/>
                <TextBox Width="110" Margin="0,0,8,6" Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by category"/>
                <TextBox Width="130" Margin="0,0,8,6" Text="{Binding ManufacturerFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by manufacturer"/>
                <Button Command="{Binding ToggleScanCommand}">
                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Resume scanning"/><Style.Triggers><DataTrigger Binding="{Binding Scanning}" Value="True"><Setter Property="Text" Value="Pause scanning"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Button>
                <Button Content="Open history" Command="{Binding OpenHistoryCommand}"/>
                <Button Content="Export results" Command="{Binding ExportViewCommand}"/>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding Count}"/>
            </WrapPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" CanUserSortColumns="True">
                <DataGrid.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="50"/>
                    <DataGridTextColumn Header="RSSI (dBm)" Binding="{Binding Rssi}" Width="85"/>
                    <DataGridTextColumn Header="Signal" Binding="{Binding RssiQuality}" Width="85" SortMemberPath="Rssi"/>
                    <DataGridTemplateColumn Header="Trend" Width="85" SortMemberPath="Trend"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Trend}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="90" SortMemberPath="LastSeenUtc"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="90"/>
                    <DataGridTemplateColumn Header="Status" Width="85" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="60"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ============ Inventory ============ -->
    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
        <Grid Margin="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Device Inventory" Grid.ColumnSpan="2"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Width="260" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, room, workstation, category, manufacturer, notes"/>
                <Button Content="Import CSV" Command="{Binding ImportCsvCommand}"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,12,0">
                <DataGrid.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="100"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="75"/>
                    <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" Width="90"/>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="85" SortMemberPath="LastSeenUtc"/>
                    <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="50"/>
                    <DataGridTextColumn Header="Seen" Binding="{Binding Observations}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding HasSelection}">
                        <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="SELECTED DEVICE"/>
                        <TextBlock Text="{Binding Selected.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Selected.Id}" FontSize="10" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Custom name"/><TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Category"/><TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Room"/><TextBox Text="{Binding EditRoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Workstation"/><TextBox Text="{Binding EditWorkstation, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Notes"/><TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Open history" Command="{Binding OpenHistoryCommand}"/></StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="MERGE (same physical device?)"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Text="Merges this device into the one picked below. Names are never merged automatically. Audited in the Event Log."/>
                        <ComboBox ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding MergeTarget}" Margin="0,6,0,6"/>
                        <Button Content="Merge into selected" Command="{Binding MergeCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{Binding Message}" TextWrapping="Wrap"/>
        </Grid>
    </DataTemplate>

    <!-- ============ History ============ -->
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Device History"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <ComboBox Width="240" Margin="0,0,8,6" ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding Device}"/>
                <ComboBox Width="150" Margin="0,0,8,6" ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedItem="{Binding Period}"/>
                <ComboBox Width="220" Margin="0,0,8,6" ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding CompareDevice}" ToolTip="Optional: compare with another device"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="6">
                <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom"
                                    LegendTextPaint="{Binding LegendPaint}" TooltipTextPaint="{Binding TooltipPaint}"/>
            </Border>
            <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Note}"/>
        </Grid>
    </DataTemplate>

    <!-- ============ Event Log ============ -->
    <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Event Log"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox Width="120" Margin="0,0,8,0" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"/>
                <TextBox Width="260" Margin="0,0,12,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search source, event type or message"/>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding Count}"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75"/>
                    <DataGridTemplateColumn Header="Severity" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="170"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ============ Bluetooth Scanner ============ -->
    <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H1}" Text="Bluetooth Scanner"/>
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel><TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warn}" Text="Scanner needs attention"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" Text="State"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding State}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Adapter"/><TextBlock Text="{Binding Adapter}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Mode"/><TextBlock Text="{Binding Mode}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Counters"/><TextBlock Text="{Binding Counters}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Start scanning" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="Stop scanning" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="SCAN MODE"/>
                <CheckBox IsChecked="{Binding AllowActive}" Content="Allow Active scanning (opt-in)"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Text="Passive (default) only listens. Active asks nearby devices for extra data (some names arrive only that way) and can add radio traffic. Neither mode connects to, pairs with or controls any device."/>
                <TextBlock Style="{StaticResource H2}" Text="COVERAGE GAPS (periods this scanner could not hear)"/>
                <ListBox ItemsSource="{Binding Gaps}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Fg}" MaxHeight="220"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="Devices are never blamed for silence that falls inside a gap."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Settings ============ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Presence window (seconds)"/>
            <TextBox Width="120" HorizontalAlignment="Left" Margin="0,2,0,2" Text="{Binding PresenceWindowSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Text="A device not heard for longer than this is shown as Missing from recent scans (only while the scanner was able to hear). It is not a disconnection verdict."/>
            <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoStartScan}" Content="Start scanning automatically when the app opens"/>
            <TextBlock Style="{StaticResource H2}" Text="DATA"/>
            <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Back up database now" Command="{Binding BackupNowCommand}"/><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/></StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Message}"/>
            <TextBlock Style="{StaticResource H2}" Text="ABOUT"/>
            <TextBlock Text="Bluetooth Fleet Monitor"/><TextBlock Style="{StaticResource MutedText}" Text="{Binding Version}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Local only: no cloud, no telemetry, no ads."/>
        </StackPanel>
    </DataTemplate>

    <!-- ============ Not built yet ============ -->
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}"/>
            <Border Background="{StaticResource AccentDim}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Phase, StringFormat='Planned: {0}'}"/></Border>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Description}"/>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}" Text="Not implemented yet. Nothing on this screen is simulated."/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
