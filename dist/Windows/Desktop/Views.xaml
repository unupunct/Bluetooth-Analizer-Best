<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BluetoothFleetMonitor.Desktop.ViewModels"
                    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <!-- ============ Dashboard ============ -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,22">
                <!-- header: title, live status, controls -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H1}" Margin="0,0,0,2" Text="Dashboard"/>
                            <Border CornerRadius="10" Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" Padding="9,2" Margin="14,4,0,0" VerticalAlignment="Center">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDemo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="DEMO DATA - not real measurements" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScannerWarning}" Value="True"><Setter Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ScannerHealthy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Good}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="pulse"><Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9" AutoReverse="True"/>
                                                    </Storyboard></BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="pulse"/></DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ScannerStateText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Adapter}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ModeText}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start scanning" Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStart}"/>
                        <Button Content="Stop scanning" Command="{Binding StopScanCommand}" IsEnabled="{Binding CanStop}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ScannerWarning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warn}" Text="Scanner needs attention"/>
                        <TextBlock Text="{Binding ScannerMessage}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI strip -->
                <UniformGrid Columns="6" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource MutedText}" Text="Registered"/><TextBlock Style="{StaticResource BigNumber}" Text="{Binding Registered}"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="devices known"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Good}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource MutedText}" Text="Detected now"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Good}" Text="{Binding Detected}"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="heard recently"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" ToolTip="Not heard recently while the scanner was able to hear. This is not proof of a disconnection."><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Warn}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource MutedText}" Text="Not heard recently"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Warn}" Text="{Binding Missing}"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="scanner could hear"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" ToolTip="The scanner was stopped, deaf or interrupted, so absence cannot be judged."><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Muted}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource MutedText}" Text="Uncertain"/><TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource Muted}" Text="{Binding Uncertain}"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="cannot be judged"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Good}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="Advertisements / s"/>
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Rate}"/>
                            <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding SparkSeries}" XAxes="{Binding SparkXAxes}" YAxes="{Binding SparkYAxes}" Height="30" TooltipPosition="Hidden"/>
                        </StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource Card}"><Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                        <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource MutedText}" Text="Last database update"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding LastUpdate}"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding PipelineText}"/></StackPanel>
                    </Grid></Border>
                </UniformGrid>

                <!-- activity + signal strength -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,2" Text="ACTIVITY  (last 10 minutes, live)"/>
                            <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding ActivitySeries}" XAxes="{Binding ActivityXAxes}" YAxes="{Binding ActivityYAxes}" Height="235" LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}" TooltipTextPaint="{Binding LegendPaint}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,8" Text="SIGNAL STRENGTH  (devices heard now)"/>
                            <ItemsControl ItemsSource="{Binding Histogram}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding Label}"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource FlatBar}" Height="14" Value="{Binding Percent}" Foreground="{Binding Fill}" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Count}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Text="RSSI is a relative signal level, not a distance."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- makers, strongest, health -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" Text="BY MAKER"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <lvc:PieChart Background="{StaticResource Panel}" Series="{Binding MakerSeries}" Height="150" LegendPosition="Hidden" InitialRotation="-90"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding MakerLegend}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Fill}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Count}" Margin="8,0,0,0"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="STRONGEST RIGHT NOW"/>
                            <ItemsControl ItemsSource="{Binding TopDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                <ProgressBar Style="{StaticResource FlatBar}" Height="5" Value="{Binding Percent}" Foreground="{Binding Fill}" Margin="0,3,10,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding RssiText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="SCANNER HEALTH"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="State"/><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ScannerStateText}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Adapter"/><TextBlock TextWrapping="Wrap" Text="{Binding Adapter}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Pipeline"/><TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding PipelineText}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Text="Nothing is dropped silently: any overflow or write failure is recorded in the Event Log."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- events -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="LIVE EVENTS  (scanner and application)"/>
                        <DataGrid ItemsSource="{Binding Events}" MaxHeight="260" HorizontalScrollBarVisibility="Disabled" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                                <DataGridTemplateColumn Header="Severity" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                                <DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="170"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <!-- ============ Live Monitor ============ -->
    <DataTemplate DataType="{x:Type vm:LiveMonitorViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Live Monitor"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBox Width="190" Margin="0,0,8,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, manufacturer, room, id"/>
                <ComboBox Width="120" Margin="0,0,8,6" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/>
                <ComboBox Width="150" Margin="0,0,8,6" ItemsSource="{Binding SignalFilters}" SelectedItem="{Binding SignalFilter}"/>
                <TextBox Width="110" Margin="0,0,8,6" Text="{Binding RoomFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by room"/>
                <TextBox Width="110" Margin="0,0,8,6" Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by category"/>
                <TextBox Width="130" Margin="0,0,8,6" Text="{Binding ManufacturerFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by manufacturer"/>
                <Button Command="{Binding ToggleScanCommand}">
                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Resume scanning"/><Style.Triggers><DataTrigger Binding="{Binding Scanning}" Value="True"><Setter Property="Text" Value="Pause scanning"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Button>
                <Button Content="Analyse" Command="{Binding AnalyseCommand}"/><Button Content="Open history" Command="{Binding OpenHistoryCommand}"/>
                <Button Content="Export results" Command="{Binding ExportViewCommand}"/>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding Count}"/>
            </WrapPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" CanUserSortColumns="True">
                <DataGrid.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="50"/>
                    <DataGridTextColumn Header="RSSI (dBm)" Binding="{Binding Rssi}" Width="85"/>
                    <DataGridTextColumn Header="Signal" Binding="{Binding RssiQuality}" Width="85" SortMemberPath="Rssi"/>
                    <DataGridTemplateColumn Header="Trend" Width="85" SortMemberPath="Trend"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Trend}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="90" SortMemberPath="LastSeenUtc"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="90"/>
                    <DataGridTemplateColumn Header="Status" Width="85" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="60"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ============ Inventory ============ -->
    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
        <Grid Margin="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Device Inventory" Grid.ColumnSpan="2"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Width="260" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, room, workstation, category, manufacturer, notes"/>
                <Button Content="Import CSV" Command="{Binding ImportCsvCommand}"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,12,0">
                <DataGrid.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="100"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="75"/>
                    <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" Width="90"/>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="85" SortMemberPath="LastSeenUtc"/>
                    <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="50"/>
                    <DataGridTextColumn Header="Seen" Binding="{Binding Observations}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding HasSelection}">
                        <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="SELECTED DEVICE"/>
                        <TextBlock Text="{Binding Selected.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Selected.Id}" FontSize="10" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Custom name"/><TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Category"/><TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Room"/><TextBox Text="{Binding EditRoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Workstation"/><TextBox Text="{Binding EditWorkstation, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Notes"/><TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Analyse" Command="{Binding AnalyseCommand}"/><Button Content="Open history" Command="{Binding OpenHistoryCommand}"/></StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="MERGE (same physical device?)"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Text="Merges this device into the one picked below. Names are never merged automatically. Audited in the Event Log."/>
                        <ComboBox ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding MergeTarget}" Margin="0,6,0,6"/>
                        <Button Content="Merge into selected" Command="{Binding MergeCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{Binding Message}" TextWrapping="Wrap"/>
        </Grid>
    </DataTemplate>

    <!-- ============ Fault Detector / Worst Offenders ============ -->
    <DataTemplate DataType="{x:Type vm:FaultsViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H1}" Text="Worst Offenders"/>
                    <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="10,2" Margin="14,2,0,0" VerticalAlignment="Top" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DEMO DATA" Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,-6,0,10"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <ComboBox Width="130" ItemsSource="{x:Static vm:FaultsViewModel.Windows}" SelectedItem="{Binding Window}" Margin="0,0,8,0" ToolTip="Time window"/>
                <ComboBox Width="120" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,8,0" ToolTip="Device category"/>
                <ComboBox Width="110" ItemsSource="{Binding Rooms}" SelectedItem="{Binding Room}" Margin="0,0,8,0" ToolTip="Room"/>
                <ComboBox Width="160" ItemsSource="{x:Static vm:FaultsViewModel.FailureTypes}" SelectedItem="{Binding FailureType}" Margin="0,0,8,0" ToolTip="Failure type"/>
                <TextBox Width="170" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Search name, room or workstation"/>
                <CheckBox Content="Only devices with findings" IsChecked="{Binding OnlyProblems}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button Content="Re-analyse" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,12,0">
                <DataGrid.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36"/>
                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="125"/>
                    <DataGridTemplateColumn Header="Health" Width="56" SortMemberPath="HealthValue">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HealthText}" Foreground="{Binding BandBrush}" FontWeight="Bold" FontSize="15"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Verdict" Width="88">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BandText}" Foreground="{Binding BandBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="48"/>
                    <DataGridTextColumn Header="Drops" Binding="{Binding Interruptions}" Width="46"/>
                    <DataGridTextColumn Header="Tests" Binding="{Binding TestsText}" Width="88"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="62"/>
                    <DataGridTextColumn Header="Main finding" Binding="{Binding TopFinding}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedHealth}" Foreground="{Binding SelectedBrush}" FontWeight="SemiBold" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource H2}" Text="WHY THIS SCORE"/>
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding ScoreText}" Style="{StaticResource MutedText}"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource FlatBar}" Height="5" Value="{Binding Percent}" Foreground="{Binding Fill}" Margin="0,3,0,3"/>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource H2}" Text="FINDINGS"/>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource H2}" Text="WHAT TO DO"/>
                        <TextBlock Text="{Binding SelectedRecommendation}" TextWrapping="Wrap" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Analyse signal" Command="{Binding AnalyseCommand}"/><Button Content="Open full history" Command="{Binding OpenHistoryCommand}"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11"/>
                <Expander Header="Shared outages (environment or scanner)" Foreground="{StaticResource Fg}" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding SharedOutages}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander Header="Score weights and thresholds (adjustable; the defaults are engineering starting points, not validated failure rates)" Foreground="{StaticResource Fg}" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Presence"/><TextBox Width="60" Text="{Binding WeightPresence}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Signal"/><TextBox Width="60" Text="{Binding WeightSignal}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Recovery"/><TextBox Width="60" Text="{Binding WeightRecovery}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="RSSI trend"/><TextBox Width="60" Text="{Binding WeightTrend}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Conn. tests"/><TextBox Width="60" Text="{Binding WeightTests}"/></StackPanel>
                            <StackPanel Margin="12,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Min gap (s)"/><TextBox Width="60" Text="{Binding MinGapSeconds}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Min observations"/><TextBox Width="80" Text="{Binding MinObservations}"/></StackPanel>
                            <StackPanel Margin="0,0,12,6"><TextBlock Style="{StaticResource MutedText}" Text="Min confidence (0-1)"/><TextBox Width="80" Text="{Binding MinConfidence}"/></StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal"><Button Content="Apply and re-analyse" Command="{Binding ApplySettingsCommand}"/><Button Content="Reset to defaults" Command="{Binding ResetSettingsCommand}"/></StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ============ Mobile Devices (phone sync) ============ -->
    <DataTemplate DataType="{x:Type vm:MobileDevicesViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="1100" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H1}" Text="Mobile Devices"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="Pair an Android phone so what it scans arrives here. Everything stays on your local network: the PC listens over HTTPS with its own certificate, the phone checks that certificate's fingerprint, and each phone has its own revocable access token. Nothing goes to the internet."/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Enabled}" Content="Accept uploads from paired phones" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ServerStatus}" Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ServerOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FirewallText}" Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding FirewallOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Allow in Windows Firewall" Command="{Binding AllowFirewallCommand}"/>
                            <Button Content="Check again" Command="{Binding RefreshFirewallCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Text="Certificate fingerprint (SHA-256, the phone pins this):"/>
                        <TextBlock Text="{Binding FingerprintText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="PAIR A NEW PHONE"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MutedText}" Text="This PC's address on the phone's network:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="170" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}"/>
                            <Button Content="Create pairing code" Command="{Binding CreateInviteCommand}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,12,0,0" Visibility="{Binding HasInvite, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="White" Padding="10" CornerRadius="6" VerticalAlignment="Top"><Image Source="{Binding Qr}" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="On the phone: open Fleet Monitor, More, Sync status, Scan pairing code." TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Code (also inside the QR):"/>
                                <TextBlock Text="{Binding InviteCode}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InviteCountdown}" Style="{StaticResource MutedText}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11" Text="No camera? Copy this link, send it to the phone and open it there; it opens the app and asks you to confirm."/>
                                <TextBox Text="{Binding InviteLink, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <Button Content="Copy link" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Text="One use, five minutes. Anyone who sees this code in that time could pair, so show it only to your own phone."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H2}" Margin="0,18,0,6" Text="PAIRED PHONES"/>
                <TextBlock Text="No phone paired yet.">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding HasPhones}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Phones}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  |  " Foreground="{StaticResource Muted}"/><Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding PairedText}"/>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastUploadText}"/>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ReceivedText}"/>
                                    <TextBlock Text="{Binding ClockText}" Foreground="{Binding ClockBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Revoke" VerticalAlignment="Top" Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Revoked}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Warn}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Signal Analysis (device deep-dive) ============ -->
    <DataTemplate DataType="{x:Type vm:SignalAnalysisViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H1}" Text="Signal Analysis"/>
                    <TextBlock Text="{Binding Title}" FontSize="20" Foreground="{StaticResource Muted}" Margin="12,0,0,10" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="10,2" Margin="14,2,0,0" VerticalAlignment="Top" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DEMO DATA" Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,-6,0,6" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}">
                <ComboBox Width="140" ItemsSource="{x:Static vm:SignalAnalysisViewModel.Windows}" SelectedItem="{Binding Window}" Margin="0,0,8,0" ToolTip="Time window"/>
                <ComboBox Width="200" ItemsSource="{Binding Scanners}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScanner}" Margin="0,0,8,0" ToolTip="Which scanner heard it. Advertisement gaps only make sense for one source."/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Content="Open full history" Command="{Binding OpenHistoryCommand}"/>
                <Button Content="Look up online" Command="{Binding LookUpOnlineCommand}" Visibility="{Binding CanLookUp, Converter={StaticResource BoolToVis}}" ToolTip="Opens your browser with a search made from the maker and name. The Bluetooth address is never sent."/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Text="Look up online opens your browser; only the maker and name go into the search, never the address."/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding HasDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Grid Grid.Row="2" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="WHAT IS THIS DEVICE"/>
                            <ItemsControl ItemsSource="{Binding ProfileLines}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,5"><TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource H2}" Text="FINDINGS"/>
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource H2}" Text="WHAT TO DO"/>
                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding StatLines}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" FontSize="12"><Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Muted}"/><Run Text="   "/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource H2}" Text="SIGNAL OVER TIME (red bands: no advertisements heard while the scanner was listening)"/>
                        <Border Style="{StaticResource Card}" Padding="6" Height="300">
                            <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding SignalSeries}" XAxes="{Binding SignalXAxes}" YAxes="{Binding SignalYAxes}" Sections="{Binding SignalSections}" LegendPosition="Bottom" LegendTextPaint="{Binding LegendPaint}" TooltipTextPaint="{Binding TooltipPaint}"/>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="HOW OFTEN THE SIGNAL WAS AT EACH LEVEL"/>
                                <Border Style="{StaticResource Card}" Padding="6" Height="200">
                                    <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding DistributionSeries}" XAxes="{Binding DistributionXAxes}" TooltipTextPaint="{Binding TooltipPaint}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="TIME BETWEEN ADVERTISEMENTS"/>
                                <Border Style="{StaticResource Card}" Padding="6" Height="200">
                                    <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding IntervalSeries}" XAxes="{Binding IntervalXAxes}" TooltipTextPaint="{Binding TooltipPaint}"/>
                                </Border>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Text="{Binding IntervalNote}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource H2}" Text="SILENT PERIODS (scanner was listening)"/>
                        <ItemsControl ItemsSource="{Binding Silences}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock FontSize="12" Margin="0,0,0,3"><Run Text="{Binding When, Mode=OneWay}"/><Run Text="   for "/><Run Text="{Binding Length, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   " /><Run Text="{Binding Levels, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource H2}" Text="SIGNAL DROPS AND RECOVERY"/>
                        <ItemsControl ItemsSource="{Binding Recoveries}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock FontSize="12" Margin="0,0,0,3"><Run Text="{Binding When, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Drop, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Recovered, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,12" TextWrapping="Wrap" Text="Breaks and red bands mean no advertisements were heard, which is not proof the device disconnected. RSSI is a relative signal level, not a distance."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ============ History ============ -->
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Device History"/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <ComboBox Width="240" Margin="0,0,8,6" ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding Device}"/>
                <ComboBox Width="150" Margin="0,0,8,6" ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedItem="{Binding Period}"/>
                <ComboBox Width="220" Margin="0,0,8,6" ItemsSource="{Binding Registry.Devices}" DisplayMemberPath="Name" SelectedItem="{Binding CompareDevice}" ToolTip="Optional: compare with another device"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="6">
                <lvc:CartesianChart Background="{StaticResource Panel}" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom"
                                    LegendTextPaint="{Binding LegendPaint}" TooltipTextPaint="{Binding TooltipPaint}"/>
            </Border>
            <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Note}"/>
        </Grid>
    </DataTemplate>

    <!-- ============ Event Log ============ -->
    <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource H1}" Text="Event Log"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox Width="120" Margin="0,0,8,0" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"/>
                <TextBox Width="260" Margin="0,0,12,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search source, event type or message"/>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding Count}"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75"/>
                    <DataGridTemplateColumn Header="Severity" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource StatusText}" Text="{Binding Severity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding Type}" Width="170"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ============ Bluetooth Scanner ============ -->
    <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H1}" Text="Bluetooth Scanner"/>
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel><TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warn}" Text="Scanner needs attention"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" Text="State"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding State}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Adapter"/><TextBlock Text="{Binding Adapter}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Mode"/><TextBlock Text="{Binding Mode}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Counters"/><TextBlock Text="{Binding Counters}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Start scanning" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="Stop scanning" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="SCAN MODE"/>
                <CheckBox IsChecked="{Binding AllowActive}" Content="Allow Active scanning (opt-in)"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Text="Passive (default) only listens. Active asks nearby devices for extra data (some names arrive only that way) and can add radio traffic. Neither mode connects to, pairs with or controls any device."/>
                <TextBlock Style="{StaticResource H2}" Text="COVERAGE GAPS (periods this scanner could not hear)"/>
                <ListBox ItemsSource="{Binding Gaps}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Fg}" MaxHeight="220"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="Devices are never blamed for silence that falls inside a gap."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============ Settings ============ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Presence window (seconds)"/>
            <TextBox Width="120" HorizontalAlignment="Left" Margin="0,2,0,2" Text="{Binding PresenceWindowSeconds, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Text="A device not heard for longer than this is shown as Missing from recent scans (only while the scanner was able to hear). It is not a disconnection verdict."/>
            <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoStartScan}" Content="Start scanning automatically when the app opens"/>
            <TextBlock Style="{StaticResource H2}" Text="DATA"/>
            <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Back up database now" Command="{Binding BackupNowCommand}"/><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/></StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Message}"/>
            <TextBlock Style="{StaticResource H2}" Text="ABOUT"/>
            <TextBlock Text="Bluetooth Fleet Monitor"/><TextBlock Style="{StaticResource MutedText}" Text="{Binding Version}"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Local only: no cloud, no telemetry, no ads."/>
        </StackPanel>
    </DataTemplate>

    <!-- ============ Not built yet ============ -->
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}"/>
            <Border Background="{StaticResource AccentDim}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Phase, StringFormat='Planned: {0}'}"/></Border>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Description}"/>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}" Text="Not implemented yet. Nothing on this screen is simulated."/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
